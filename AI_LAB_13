    {
      "cell_type": "code",
      "source": [
        "\n",
        "\n",
        "import os\n",
        "import random\n",
        "import warnings\n",
        "import numpy as np\n",
        "import pandas as pd\n",
        "import matplotlib.pyplot as plt\n",
        "import seaborn as sns\n",
        "import tensorflow as tf\n",
        "from sklearn.datasets import load_iris\n",
        "from sklearn.model_selection import train_test_split\n",
        "from sklearn.preprocessing import StandardScaler\n",
        "from sklearn.metrics import (\n",
        "    confusion_matrix,\n",
        "    classification_report,\n",
        "    accuracy_score,\n",
        "    precision_score,\n",
        "    recall_score,\n",
        "    f1_score,\n",
        "    roc_curve,\n",
        "    auc\n",
        ")\n",
        "from sklearn.preprocessing import label_binarize\n",
        "from tensorflow.keras.models import Model\n",
        "from tensorflow.keras.layers import (\n",
        "    Input,\n",
        "    Conv1D,\n",
        "    BatchNormalization,\n",
        "    Activation,\n",
        "    GlobalMaxPooling1D,\n",
        "    GlobalAveragePooling1D,\n",
        "    Dense,\n",
        "    Dropout,\n",
        "    Concatenate\n",
        ")\n",
        "from tensorflow.keras.callbacks import (\n",
        "    EarlyStopping,\n",
        "    ReduceLROnPlateau,\n",
        "    ModelCheckpoint\n",
        ")\n",
        "from tensorflow.keras.utils import to_categorical\n",
        "\n",
        "warnings.filterwarnings(\"ignore\")\n",
        "\n",
        "# ============================================================\n",
        "# 1. REPRODUCIBILITY CONFIGURATION\n",
        "# ============================================================\n",
        "SEED = 42\n",
        "os.environ[\"PYTHONHASHSEED\"] = str(SEED)\n",
        "random.seed(SEED)\n",
        "np.random.seed(SEED)\n",
        "tf.random.set_seed(SEED)\n",
        "sns.set_theme(style=\"whitegrid\", context=\"notebook\")\n",
        "\n",
        "print(\"=\" * 70)\n",
        "print(\" ADVANCED 1D CNN: IRIS FLOWER CLASSIFICATION \")\n",
        "print(\"=\" * 70)\n",
        "\n",
        "# ============================================================\n",
        "# 2. LOAD AND INSPECT THE DATASET\n",
        "# ============================================================\n",
        "iris = load_iris()\n",
        "X = iris.data\n",
        "y = iris.target\n",
        "feature_names = iris.feature_names\n",
        "class_names = iris.target_names\n",
        "num_classes = len(class_names)\n",
        "\n",
        "df = pd.DataFrame(X, columns=feature_names)\n",
        "df[\"species\"] = [class_names[i] for i in y]\n",
        "\n",
        "print(\"\\nDataset shape :\", X.shape)\n",
        "print(\" Target shape :\", y.shape)\n",
        "print(\" Feature names :\", feature_names)\n",
        "print(\" Class names :\", class_names)\n",
        "print(\"\\nClass distribution :\")\n",
        "print(df[\"species\"].value_counts())\n",
        "print(\"\\nStatistical summary :\")\n",
        "print(df.describe().round(3))\n",
        "\n",
        "# ============================================================\n",
        "# 3. DATASET VISUALIZATION\n",
        "# ============================================================\n",
        "# 3.1 Class distribution\n",
        "plt.figure(figsize=(8, 5))\n",
        "sns.countplot(\n",
        "    data=df,\n",
        "    x=\"species\",\n",
        "    order=class_names\n",
        ")\n",
        "plt.title(\"Distribution of Iris Flower Classes\")\n",
        "plt.xlabel(\"Flower Species\")\n",
        "plt.ylabel(\"Number of Samples\")\n",
        "plt.tight_layout()\n",
        "plt.show()\n",
        "\n",
        "# 3.2 Feature distributions\n",
        "fig, axes = plt.subplots(2, 2, figsize=(13, 9))\n",
        "for i, ax in enumerate(axes.flat):\n",
        "    sns.histplot(\n",
        "        data=df,\n",
        "        x=feature_names[i],\n",
        "        hue=\"species\",\n",
        "        kde=True,\n",
        "        element=\"step\",\n",
        "        ax=ax\n",
        "    )\n",
        "    ax.set_title(f\"Distribution of {feature_names[i]}\")\n",
        "plt.suptitle(\"Feature Distribution by Iris Species\", fontsize=15)\n",
        "plt.tight_layout()\n",
        "plt.show()\n",
        "\n",
        "# 3.3 Correlation matrix\n",
        "plt.figure(figsize=(9, 7))\n",
        "correlation = df[feature_names].corr()\n",
        "sns.heatmap(\n",
        "    correlation,\n",
        "    annot=True,\n",
        "    fmt=\".2f\",\n",
        "    cmap=\"coolwarm\",\n",
        "    square=True,\n",
        "    linewidths=0.5\n",
        ")\n",
        "plt.title(\"Correlation Matrix of Iris Features\")\n",
        "plt.tight_layout()\n",
        "plt.show()\n",
        "\n",
        "# 3.4 Pairwise feature relationships\n",
        "sns.pairplot(\n",
        "    df,\n",
        "    hue=\"species\",\n",
        "    vars=feature_names,\n",
        "    diag_kind=\"hist\"\n",
        ")\n",
        "plt.suptitle(\"Pairwise Relationships Among Iris Features\", y=1.02)\n",
        "plt.show()\n",
        "\n",
        "# ============================================================\n",
        "# 4. TRAIN - TEST SPLITTING AND PREPROCESSING\n",
        "# ============================================================\n",
        "X_train, X_test, y_train, y_test = train_test_split(\n",
        "    X,\n",
        "    y,\n",
        "    test_size=0.20,\n",
        "    random_state=SEED,\n",
        "    stratify=y\n",
        ")\n",
        "\n",
        "# Fit scaler only on training set to prevent data leakage\n",
        "scaler = StandardScaler()\n",
        "X_train_scaled = scaler.fit_transform(X_train)\n",
        "X_test_scaled = scaler.transform(X_test)\n",
        "\n",
        "# Reshape for 1D CNN: (samples, sequence_length, channels)\n",
        "X_train_cnn = X_train_scaled.reshape(\n",
        "    X_train_scaled.shape[0],\n",
        "    X_train_scaled.shape[1],\n",
        "    1\n",
        ")\n",
        "X_test_cnn = X_test_scaled.reshape(\n",
        "    X_test_scaled.shape[0],\n",
        "    X_test_scaled.shape[1],\n",
        "    1\n",
        ")\n",
        "\n",
        "y_train_encoded = to_categorical(y_train, num_classes)\n",
        "y_test_encoded = to_categorical(y_test, num_classes)\n",
        "\n",
        "print(\"\\nTraining samples :\", X_train_cnn.shape[0])\n",
        "print(\" Testing samples :\", X_test_cnn.shape[0])\n",
        "print(\"CNN input shape :\", X_train_cnn.shape)\n",
        "print(\"CNN test input shape :\", X_test_cnn.shape)\n",
        "\n",
        "# ============================================================\n",
        "# 5. BUILD THE ADVANCED 1D CNN ARCHITECTURE\n",
        "# ============================================================\n",
        "inputs = Input(shape=(X_train_cnn.shape[1], 1), name=\"iris_input\")\n",
        "\n",
        "# Convolutional block 1\n",
        "x = Conv1D(\n",
        "    filters=32,\n",
        "    kernel_size=2,\n",
        "    padding=\"same\",\n",
        "    use_bias=False,\n",
        "    name=\"conv_block_1\"\n",
        ")(inputs)\n",
        "x = BatchNormalization(name=\"batch_norm_1\")(x)\n",
        "x = Activation(\"relu\", name=\"relu_1\")(x)\n",
        "\n",
        "# Convolutional block 2\n",
        "x = Conv1D(\n",
        "    filters=64,\n",
        "    kernel_size=2,\n",
        "    padding=\"same\",\n",
        "    use_bias=False,\n",
        "    name=\"conv_block_2\"\n",
        ")(x)\n",
        "x = BatchNormalization(name=\"batch_norm_2\")(x)\n",
        "x = Activation(\"relu\", name=\"relu_2\")(x)\n",
        "\n",
        "# Convolutional block 3\n",
        "x = Conv1D(\n",
        "    filters=64,\n",
        "    kernel_size=2,\n",
        "    padding=\"same\",\n",
        "    use_bias=False,\n",
        "    name=\"conv_block_3\"\n",
        ")(x)\n",
        "x = BatchNormalization(name=\"batch_norm_3\")(x)\n",
        "x = Activation(\"relu\", name=\"relu_3\")(x)\n",
        "\n",
        "# Parallel feature aggregation\n",
        "max_features = GlobalMaxPooling1D(name=\"global_max_pooling\")(x)\n",
        "avg_features = GlobalAveragePooling1D(name=\"global_average_pooling\")(x)\n",
        "x = Concatenate(name=\"feature_fusion\")(\n",
        "    [max_features, avg_features]\n",
        ")\n",
        "\n",
        "# Dense classification head\n",
        "x = Dense(64, activation=\"relu\", name=\"dense_1\")(x)\n",
        "x = Dropout(0.30, name=\"dropout_1\")(x)\n",
        "x = Dense(32, activation=\"relu\", name=\"dense_2\")(x)\n",
        "x = Dropout(0.20, name=\"dropout_2\")(x)\n",
        "outputs = Dense(\n",
        "    num_classes,\n",
        "    activation=\"softmax\",\n",
        "    name=\"class_probabilities\"\n",
        ")(x)\n",
        "\n",
        "model = Model(\n",
        "    inputs=inputs,\n",
        "    outputs=outputs,\n",
        "    name=\"Advanced_Iris_1D_CNN\"\n",
        ")\n",
        "\n",
        "model.compile(\n",
        "    optimizer=tf.keras.optimizers.Adam(learning_rate=0.001),\n",
        "    loss=\"categorical_crossentropy\",\n",
        "    metrics=[\"accuracy\"]\n",
        ")\n",
        "\n",
        "print(\"\\nMODEL ARCHITECTURE\")\n",
        "print(\"=\" * 70)\n",
        "model.summary()\n",
        "\n",
        "# ============================================================\n",
        "# 6. VISUALIZE THE MODEL ARCHITECTURE\n",
        "# ============================================================\n",
        "try:\n",
        "    tf.keras.utils.plot_model(\n",
        "        model,\n",
        "        to_file=\"iris_cnn_architecture.png\",\n",
        "        show_shapes=True,\n",
        "        show_layer_names=True,\n",
        "        expand_nested=True,\n",
        "        dpi=120\n",
        "    )\n",
        "    print(\"\\nModel architecture saved as iris_cnn_architecture.png\")\n",
        "except Exception as error:\n",
        "    print(\"\\nOptional architecture diagram unavailable :\", error)\n",
        "\n",
        "# ============================================================\n",
        "# 7. TRAINING CALLBACKS\n",
        "# ============================================================\n",
        "early_stopping = EarlyStopping(\n",
        "    monitor=\"val_loss\",\n",
        "    patience=20,\n",
        "    restore_best_weights=True,\n",
        "    verbose=1\n",
        ")\n",
        "\n",
        "reduce_lr = ReduceLROnPlateau(\n",
        "    monitor=\"val_loss\",\n",
        "    factor=0.5,\n",
        "    patience=7,\n",
        "    min_lr=1e-6,\n",
        "    verbose=1\n",
        ")\n",
        "\n",
        "checkpoint = ModelCheckpoint(\n",
        "    filepath=\"best_iris_cnn.keras\",\n",
        "    monitor=\"val_loss\",\n",
        "    save_best_only=True,\n",
        "    verbose=1\n",
        ")\n",
        "\n",
        "# ============================================================\n",
        "# 8. TRAIN THE MODEL\n",
        "# ============================================================\n",
        "print(\"\\nSTARTING CNN TRAINING\")\n",
        "print(\"=\" * 70)\n",
        "history = model.fit(\n",
        "    X_train_cnn,\n",
        "    y_train_encoded,\n",
        "    epochs=150,\n",
        "    batch_size=16,\n",
        "    validation_split=0.20,\n",
        "    callbacks=[\n",
        "        early_stopping,\n",
        "        reduce_lr,\n",
        "        checkpoint\n",
        "    ],\n",
        "    verbose=1,\n",
        "    shuffle=True\n",
        ")\n",
        "\n",
        "# ============================================================\n",
        "# 9. EVALUATE THE TRAINED MODEL\n",
        "# ============================================================\n",
        "test_loss, test_accuracy = model.evaluate(\n",
        "    X_test_cnn,\n",
        "    y_test_encoded,\n",
        "    verbose=0\n",
        ")\n",
        "\n",
        "y_prob = model.predict(X_test_cnn, verbose=0)\n",
        "y_pred = np.argmax(y_prob, axis=1)\n",
        "\n",
        "accuracy = accuracy_score(y_test, y_pred)\n",
        "precision = precision_score(\n",
        "    y_test, y_pred, average=\"macro\", zero_division=0\n",
        ")\n",
        "recall = recall_score(\n",
        "    y_test, y_pred, average=\"macro\", zero_division=0\n",
        ")\n",
        "f1 = f1_score(\n",
        "    y_test, y_pred, average=\"macro\", zero_division=0\n",
        ")\n",
        "\n",
        "print(\"\\nFINAL TEST RESULTS\")\n",
        "print(\"=\" * 70)\n",
        "print(f\"Test loss : {test_loss:.4f}\")\n",
        "print(f\"Test accuracy : {test_accuracy:.4f}\")\n",
        "print(f\"Accuracy score : {accuracy:.4f}\")\n",
        "print(f\"Macro precision : {precision:.4f}\")\n",
        "print(f\"Macro recall : {recall:.4f}\")\n",
        "print(f\"Macro F1-score : {f1:.4f}\")\n",
        "\n",
        "# ============================================================\n",
        "# 10. TRAINING AND VALIDATION CURVES\n",
        "# ============================================================\n",
        "epochs_ran = range(1, len(history.history[\"loss\"]) + 1)\n",
        "fig, axes = plt.subplots(1, 2, figsize=(14, 5))\n",
        "\n",
        "axes[0].plot(\n",
        "    epochs_ran,\n",
        "    history.history[\"accuracy\"],\n",
        "    label=\"Training Accuracy\",\n",
        "    linewidth=2\n",
        ")\n",
        "axes[0].plot(\n",
        "    epochs_ran,\n",
        "    history.history[\"val_accuracy\"],\n",
        "    label=\"Validation Accuracy\",\n",
        "    linewidth=2\n",
        ")\n",
        "axes[0].set_title(\"CNN Accuracy Across Epochs\")\n",
        "axes[0].set_xlabel(\"Epoch\")\n",
        "axes[0].set_ylabel(\"Accuracy\")\n",
        "axes[0].legend()\n",
        "axes[0].grid(True, alpha=0.3)\n",
        "\n",
        "axes[1].plot(\n",
        "    epochs_ran,\n",
        "    history.history[\"loss\"],\n",
        "    label=\"Training Loss\",\n",
        "    linewidth=2\n",
        ")\n",
        "axes[1].plot(\n",
        "    epochs_ran,\n",
        "    history.history[\"val_loss\"],\n",
        "    label=\"Validation Loss\",\n",
        "    linewidth=2\n",
        ")\n",
        "axes[1].set_title(\"CNN Loss Across Epochs\")\n",
        "axes[1].set_xlabel(\"Epoch\")\n",
        "axes[1].set_ylabel(\"Categorical Cross-Entropy\")\n",
        "axes[1].legend()\n",
        "axes[1].grid(True, alpha=0.3)\n",
        "\n",
        "plt.tight_layout()\n",
        "plt.show()\n",
        "\n",
        "# ============================================================\n",
        "# 11. LEARNING RATE HISTORY\n",
        "# ============================================================\n",
        "learning_rates = history.history.get(\"learning_rate\")\n",
        "if learning_rates is not None:\n",
        "    plt.figure(figsize=(9, 4))\n",
        "    plt.plot(\n",
        "        range(1, len(learning_rates) + 1),\n",
        "        learning_rates,\n",
        "        marker=\"o\"\n",
        "    )\n",
        "    plt.yscale(\"log\")\n",
        "    plt.xlabel(\"Epoch\")\n",
        "    plt.ylabel(\"Learning Rate\")\n",
        "    plt.title(\"Learning Rate Adaptation During Training\")\n",
        "    plt.grid(True, alpha=0.3)\n",
        "    plt.tight_layout()\n",
        "    plt.show()\n",
        "\n",
        "# ============================================================\n",
        "# 12. VISUALIZE LEARNED CONVOLUTIONAL FILTERS\n",
        "# ============================================================\n",
        "for layer_name in [\n",
        "    \"conv_block_1\",\n",
        "    \"conv_block_2\",\n",
        "    \"conv_block_3\"\n",
        "]:\n",
        "    conv_layer = model.get_layer(layer_name)\n",
        "    weights = conv_layer.get_weights()[0]\n",
        "    n_filters = weights.shape[-1]\n",
        "    n_channels = weights.shape[1]\n",
        "\n",
        "    fig, axes = plt.subplots(\n",
        "        n_channels,\n",
        "        1,\n",
        "        figsize=(12, 3 * n_channels),\n",
        "        squeeze=False\n",
        "    )\n",
        "\n",
        "    for channel in range(n_channels):\n",
        "        ax = axes[channel, 0]\n",
        "\n",
        "        for filter_index in range(n_filters):\n",
        "            ax.plot(\n",
        "                weights[:, channel, filter_index],\n",
        "                alpha=0.55,\n",
        "                linewidth=1\n",
        "            )\n",
        "\n",
        "        ax.set_title(\n",
        "            f\"{layer_name}: Learned Kernel Weights, \"\n",
        "            f\"Input Channel {channel + 1}\"\n",
        "        )\n",
        "        ax.set_xlabel(\"Kernel Position\")\n",
        "        ax.set_ylabel(\"Weight\")\n",
        "        ax.grid(True, alpha=0.25)\n",
        "\n",
        "    plt.tight_layout()\n",
        "    plt.show()\n",
        "\n",
        "# ============================================================\n",
        "# 13. VISUALIZE INTERMEDIATE FEATURE MAPS\n",
        "# ============================================================\n",
        "feature_layer_names = [\n",
        "    \"relu_1\",\n",
        "    \"relu_2\",\n",
        "    \"relu_3\"\n",
        "]\n",
        "feature_model = Model(\n",
        "    inputs=model.input,\n",
        "    outputs=[\n",
        "        model.get_layer(name).output\n",
        "        for name in feature_layer_names\n",
        "    ]\n",
        ")\n",
        "\n",
        "# Visualize first test sample\n",
        "sample_index = 0\n",
        "sample = X_test_cnn[sample_index:sample_index + 1]\n",
        "feature_maps = feature_model.predict(sample, verbose=0)\n",
        "\n",
        "print(\"\\nActual class :\", class_names[y_test[sample_index]])\n",
        "print(\" Predicted class :\", class_names[y_pred[sample_index]])\n",
        "\n",
        "for layer_name, activations in zip(\n",
        "    feature_layer_names,\n",
        "    feature_maps\n",
        "):\n",
        "    activations = activations[0]\n",
        "    number_to_display = min(16, activations.shape[-1])\n",
        "\n",
        "    fig, axes = plt.subplots(4, 4, figsize=(12, 8))\n",
        "\n",
        "    for i, ax in enumerate(axes.flat):\n",
        "        if i < number_to_display:\n",
        "            ax.plot(\n",
        "                activations[:, i],\n",
        "                marker=\"o\",\n",
        "                linewidth=1.5\n",
        "            )\n",
        "            ax.set_title(f\"Filter {i + 1}\")\n",
        "            ax.set_xlabel(\"Feature Position\")\n",
        "            ax.set_ylabel(\"Activation\")\n",
        "            ax.grid(True, alpha=0.2)\n",
        "        else:\n",
        "            ax.axis(\"off\")\n",
        "\n",
        "    plt.suptitle(\n",
        "        f\"Intermediate Feature Maps : {layer_name}\",\n",
        "        fontsize=14\n",
        "    )\n",
        "    plt.tight_layout()\n",
        "    plt.show()\n",
        "\n",
        "# ============================================================\n",
        "# 14. GLOBAL POOLING VISUALIZATION\n",
        "# ============================================================\n",
        "pooling_model = Model(\n",
        "    inputs=model.input,\n",
        "    outputs=[\n",
        "        model.get_layer(\"global_max_pooling\").output,\n",
        "        model.get_layer(\"global_average_pooling\").output\n",
        "    ]\n",
        ")\n",
        "max_pool_values, avg_pool_values = pooling_model.predict(\n",
        "    sample,\n",
        "    verbose=0\n",
        ")\n",
        "max_pool_values = max_pool_values[0]\n",
        "avg_pool_values = avg_pool_values[0]\n",
        "pool_indices = np.arange(len(max_pool_values))\n",
        "\n",
        "plt.figure(figsize=(14, 5))\n",
        "plt.plot(\n",
        "    pool_indices,\n",
        "    max_pool_values,\n",
        "    marker=\"o\",\n",
        "    label=\"Global Max Pooling\"\n",
        ")\n",
        "plt.plot(\n",
        "    pool_indices,\n",
        "    avg_pool_values,\n",
        "    marker=\"s\",\n",
        "    label=\"Global Average Pooling\"\n",
        ")\n",
        "plt.title(\"Comparison of Global Pooling Representations\")\n",
        "plt.xlabel(\"Feature Channel\")\n",
        "plt.ylabel(\"Activation Value\")\n",
        "plt.legend()\n",
        "plt.grid(True, alpha=0.3)\n",
        "plt.tight_layout()\n",
        "plt.show()\n",
        "\n",
        "# ============================================================\n",
        "# 15. CONFUSION MATRIX WITH BLUE SHADES\n",
        "# ============================================================\n",
        "cm = confusion_matrix(\n",
        "    y_test,\n",
        "    y_pred,\n",
        "    labels=np.arange(num_classes)\n",
        ")\n",
        "\n",
        "plt.figure(figsize=(9, 7))\n",
        "ax = sns.heatmap(\n",
        "    cm,\n",
        "    annot=True,\n",
        "    fmt=\"d\",\n",
        "    cmap=\"Blues\",\n",
        "    xticklabels=class_names,\n",
        "    yticklabels=class_names,\n",
        "    linewidths=1.2,\n",
        "    linecolor=\"white\",\n",
        "    square=True,\n",
        "    cbar=True,\n",
        "    annot_kws={\"size\": 16, \"weight\": \"bold\"}\n",
        ")\n",
        "\n",
        "for i in range(num_classes):\n",
        "    for j in range(num_classes):\n",
        "        if i == j:\n",
        "            ax.add_patch(\n",
        "                plt.Rectangle(\n",
