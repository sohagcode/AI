        "      \"source\": [\n",
        "        \"<a href=\\\"https://colab.research.google.com/github/RIK-MISTRI/AI-LAB-COL/blob/main/AI_LAB_EXP_15.ipynb\\\" target=\\\"_parent\\\"><img src=\\\"https://colab.research.google.com/assets/colab-badge.svg\\\" alt=\\\"Open In Colab\\\"/></a>\"\n",
        "      ]\n",
        "    },\n",
        "    {\n",
        "      \"cell_type\": \"code\",\n",
        "      \"source\": [\n",
        "        \"import warnings\\n\",\n",
        "        \"import matplotlib.pyplot as plt\\n\",\n",
        "        \"import numpy as np\\n\",\n",
        "        \"import seaborn as sns\\n\",\n",
        "        \"import tensorflow as tf\\n\",\n",
        "        \"from sklearn.metrics import accuracy_score, classification_report, confusion_matrix\\n\",\n",
        "        \"from sklearn.model_selection import train_test_split\\n\",\n",
        "        \"from tensorflow.keras.callbacks import EarlyStopping, ModelCheckpoint\\n\",\n",
        "        \"from tensorflow.keras.datasets import fashion_mnist\\n\",\n",
        "        \"from tensorflow.keras.layers import (\\n\",\n",
        "        \"    Activation,\\n\",\n",
        "        \"    BatchNormalization,\\n\",\n",
        "        \"    Concatenate,\\n\",\n",
        "        \"    Conv2D,\\n\",\n",
        "        \"    Dense,\\n\",\n",
        "        \"    Dropout,\\n\",\n",
        "        \"    GlobalAveragePooling2D,\\n\",\n",
        "        \"    GlobalMaxPooling2D,\\n\",\n",
        "        \"    Input,\\n\",\n",
        "        \"    MaxPooling2D,\\n\",\n",
        "        \")\\n\",\n",
        "        \"from tensorflow.keras.models import Model\\n\",\n",
        "        \"from tensorflow.keras.utils import to_categorical\\n\",\n",
        "        \"\\n\",\n",
        "        \"warnings.filterwarnings(\\\"ignore\\\")\\n\",\n",
        "        \"tf.random.set_seed(42)\\n\",\n",
        "        \"\\n\",\n",
        "        \"# 1. Load & Preprocess Fashion-MNIST Data\\n\",\n",
        "        \"(X_train, y_train), (X_test, y_test) = fashion_mnist.load_data()\\n\",\n",
        "        \"class_names = [\\n\",\n",
        "        \"    \\\"T-shirt/top\\\", \\\"Trouser\\\", \\\"Pullover\\\", \\\"Dress\\\", \\\"Coat\\\",\\n\",\n",
        "        \"    \\\"Sandal\\\", \\\"Shirt\\\", \\\"Sneaker\\\", \\\"Bag\\\", \\\"Ankle boot\\\"\\n\",\n",
        "        \"]\\n\",\n",
        "        \"num_classes = len(class_names)\\n\",\n",
        "        \"\\n\",\n",
        "        \"X_train = X_train.astype(\\\"float32\\\") / 255.0\\n\",\n",
        "        \"X_test = X_test.astype(\\\"float32\\\") / 255.0\\n\",\n",
        "        \"X_train = np.expand_dims(X_train, axis=-1)\\n\",\n",
        "        \"X_test = np.expand_dims(X_test, axis=-1)\\n\",\n",
        "        \"\\n\",\n",
        "        \"y_train_enc = to_categorical(y_train, num_classes)\\n\",\n",
        "        \"y_test_enc = to_categorical(y_test, num_classes)\\n\",\n",
        "        \"\\n\",\n",
        "        \"X_tr, X_val, y_tr, y_val = train_test_split(\\n\",\n",
        "        \"    X_train, y_train_enc, test_size=0.15, random_state=42, stratify=y_train\\n\",\n",
        "        \")\\n\",\n",
        "        \"\\n\",\n",
        "        \"# 2. Build 2D CNN Architecture with Dual Global Pooling\\n\",\n",
        "        \"inputs = Input(shape=(28, 28, 1))\\n\",\n",
        "        \"x = Conv2D(32, (3, 3), padding=\\\"same\\\", use_bias=False)(inputs)\\n\",\n",
        "        \"x = BatchNormalization()(x)\\n\",\n",
        "        \"x = Activation(\\\"relu\\\")(x)\\n\",\n",
        "        \"x = MaxPooling2D((2, 2))(x)\\n\",\n",
        "        \"\\n\",\n",
        "        \"x = Conv2D(64, (3, 3), padding=\\\"same\\\", use_bias=False)(x)\\n\",\n",
        "        \"x = BatchNormalization()(x)\\n\",\n",
        "        \"x = Activation(\\\"relu\\\")(x)\\n\",\n",
        "        \"x = MaxPooling2D((2, 2))(x)\\n\",\n",
        "        \"\\n\",\n",
        "        \"x = Conv2D(128, (3, 3), padding=\\\"same\\\", use_bias=False)(x)\\n\",\n",
        "        \"x = BatchNormalization()(x)\\n\",\n",
        "        \"x = Activation(\\\"relu\\\")(x)\\n\",\n",
        "        \"\\n\",\n",
        "        \"max_p = GlobalMaxPooling2D()(x)\\n\",\n",
        "        \"avg_p = GlobalAveragePooling2D()(x)\\n\",\n",
        "        \"x = Concatenate()([max_p, avg_p])\\n\",\n",
        "        \"\\n\",\n",
        "        \"x = Dense(128, activation=\\\"relu\\\")(x)\\n\",\n",
        "        \"x = Dropout(0.3)(x)\\n\",\n",
        "        \"outputs = Dense(num_classes, activation=\\\"softmax\\\")(x)\\n\",\n",
        "        \"\\n\",\n",
        "        \"model = Model(inputs, outputs)\\n\",\n",
        "        \"model.compile(\\n\",\n",
        "        \"    optimizer=tf.keras.optimizers.Adam(0.001),\\n\",\n",
        "        \"    loss=\\\"categorical_crossentropy\\\",\\n\",\n",
        "        \"    metrics=[\\\"accuracy\\\"],\\n\",\n",
        "        \")\\n\",\n",
        "        \"\\n\",\n",
        "        \"# 3. Train Model\\n\",\n",
        "        \"history = model.fit(\\n\",\n",
        "        \"    X_tr, y_tr,\\n\",\n",
        "        \"    epochs=20,\\n\",\n",
        "        \"    batch_size=64,\\n\",\n",
        "        \"    validation_data=(X_val, y_val),\\n\",\n",
        "        \"    callbacks=[\\n\",\n",
        "        \"        EarlyStopping(monitor=\\\"val_loss\\\", patience=5, restore_best_weights=True),\\n\",\n",
        "        \"        ModelCheckpoint(\\\"best_2d_cnn.keras\\\", save_best_only=True, verbose=0)\\n\",\n",
        "        \"    ],\\n\",\n",
        "        \"    verbose=1,\\n\",\n",
        "        \")\\n\",\n",
        "        \"\\n\",\n",
        "        \"# 4. Evaluate & Predict\\n\",\n",
        "        \"y_prob = model.predict(X_test, verbose=0)\\n\",\n",
        "        \"y_pred = np.argmax(y_prob, axis=1)\\n\",\n",
        "        \"\\n\",\n",
        "        \"print(f\\\"\\\\nTest Accuracy: {accuracy_score(y_test, y_pred)*100:.2f}%\\\")\\n\",\n",
        "        \"print(\\\"\\\\nClassification Report:\\\\n\\\", classification_report(y_test, y_pred, target_names=class_names))\\n\",\n",
        "        \"\\n\",\n",
        "        \"# 5. Confusion Matrix Heatmap\\n\",\n",
        "        \"cm = confusion_matrix(y_test, y_pred)\\n\",\n",
        "        \"plt.figure(figsize=(9, 7))\\n\",\n",
        "        \"sns.heatmap(\\n\",\n",
        "        \"    cm, annot=True, fmt=\\\"d\\\", cmap=\\\"Blues\\\",\\n\",\n",
        "        \"    xticklabels=class_names, yticklabels=class_names, linewidths=0.5\\n\",\n",
        "        \")\\n\",\n",
        "        \"plt.title(\\\"2D CNN Confusion Matrix (Fashion-MNIST)\\\")\\n\",\n",
        "        \"plt.xlabel(\\\"Predicted Label\\\")\\n\",\n",
        "        \"plt.ylabel(\\\"True Label\\\")\\n\",\n",
        "        \"plt.tight_layout()\\n\",\n",
        "        \"plt.show()\"\n",
        "      ],\n",
